# some more ls aliases
alias ll='ls -l --time-style=+%Y-%m-%d\ %H:%M:%S'
alias ..='cd ..'
alias ...='cd .. && cd ..'
alias ....='cd .. && cd .. && cd ..'
alias .....='cd .. && cd .. && cd .. && cd ..'
alias feh='feh --edit -dF --auto-rotate --info "feh-exif-info %F"'
alias 2git='cd ~/git'
alias astrovnc='vncviewer -FullScreen astroberry.local'

